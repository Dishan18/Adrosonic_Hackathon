# SOV Intelligence System — Environment Variables

# LLM Provider: "groq", "gemini", or "ollama" ("none" = deterministic-only mode)
LLM_PROVIDER=groq

# Groq API key (get from console.groq.com)
GROQ_API_KEY=

# Groq model (default: llama-3.3-70b-versatile, fallback: qwen/qwen3.8-27b)
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini settings (fallback if Groq fails, or primary if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama settings (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Embedding model (HuggingFace)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ChromaDB persist directory
CHROMA_PERSIST_DIR=./chroma_db

# SQLite checkpoint database
CHECKPOINT_DB=./checkpoints.sqlite

# Output directory for exported files
OUTPUT_DIR=./outputs

# Upload directory for temp files
UPLOAD_DIR=./uploads

# Confidence thresholds
FUZZY_THRESHOLD=0.75
SEMANTIC_THRESHOLD=0.70
HIGH_CONFIDENCE_THRESHOLD=0.90

# Max re-reason attempts before escalation
MAX_REREASON_ATTEMPTS=2

# Max sample rows sent to LLM (data minimisation)
LLM_SAMPLE_ROWS=5
